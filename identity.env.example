# Identity file for your agent. install.sh interviews you once and writes the real copy to
# ~/.config/neva/identity.env with permissions 600. This example ships with obviously-fake
# placeholders; nothing real ever lives in the repo.
#
# Format rules: KEY="value", one per line, no spaces around =. Readable by bash (source),
# python (lib/config.py), and systemd (EnvironmentFile=). Comments start with #.

OWNER_NAME="Sam Example"
AGENT_NAME="Aria"
OWNER_EMAIL="you@example.com"
OWNER_PHONE="+9990000000"
OWNER_CHAT_ID="000000000"
TIMEZONE="UTC"
VAULT_PATH="$HOME/Vault"
WORKSPACE_PATH="$HOME/.openclaw/workspace"
MODEL_BACKEND="claude-cli"
TAP_BASE_URL=""
ACTIVE_HOURS_START="08:00"
ACTIVE_HOURS_END="22:00"
QUIET_DAYS=""
LEDGER_FILE="$VAULT_PATH/05 Money/2026.journal"
FOOD_DIR="$VAULT_PATH/Food"
FOOD_KCAL_TARGET=""
FOOD_PROTEIN_TARGET=""
