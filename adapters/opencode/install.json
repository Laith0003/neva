{
  "_generated": "generated by build/adapters.py from plugins/neva-core, do not edit",
  "detect": {
    "binaries": [
      "opencode"
    ],
    "paths": [
      "~/.config/opencode",
      ".opencode",
      "opencode.json"
    ]
  },
  "entries": [
    {
      "dest": "~/.config/opencode/agents/neva",
      "key": "",
      "mode": "copy",
      "src": "agents"
    },
    {
      "dest": "~/.config/opencode/commands/neva",
      "key": "",
      "mode": "copy",
      "src": "commands"
    },
    {
      "dest": "~/.config/opencode/skills/neva",
      "key": "",
      "mode": "copy",
      "src": "skills"
    },
    {
      "dest": "~/.config/opencode/rules/neva-core",
      "key": "",
      "mode": "copy",
      "src": "rules"
    },
    {
      "dest": "~/.config/opencode/plugins/neva-hooks.js",
      "key": "",
      "mode": "copy",
      "src": "plugins/neva-hooks.js"
    },
    {
      "dest": "~/.config/opencode/AGENTS.md",
      "key": "neva-core",
      "mode": "append-block",
      "src": "AGENTS.md"
    },
    {
      "dest": "~/.config/opencode/opencode.json",
      "key": "instructions",
      "mode": "append-json",
      "src": "opencode.json"
    }
  ],
  "harness": "opencode",
  "post": [
    "export NEVA_ROOT=<path to the Neva checkout>   # the hook bridge stays off without it"
  ]
}
