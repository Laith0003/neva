<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly continuous-learning-v2 job: apply ticked proposals, analyze observations, decay, prune, propose.
     Vault from NEVA_VAULT or VAULT_PATH in ~/.config/neva/identity.env. PATH must reach the claude binary. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.neva.instinct-analyze</string>
  <key>ProgramArguments</key><array><string>@PREFIX@/services/heartbeat-wrap.sh</string><string>instinct-analyze</string><string>/usr/bin/env</string><string>python3</string><string>@PREFIX@/plugins/neva-core/skills/continuous-learning-v2/scripts/instinct-analyze.py</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>@SERVICE_PATH@</string>
    <key>HEARTBEAT_TIMEOUT</key><string>3600</string>
  </dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>@HOME@/.local/state/neva/instinct-analyze.err.log</string>
</dict></plist>
