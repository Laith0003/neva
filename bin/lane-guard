#!/bin/bash
# lane-guard: recover the agent's Telegram lane when it locks itself.
#
# Failure seen 2026-07-30 16:12: a long turn blew its reply timeout and openclaw logged
#   "timed out spooled update <id> had no active reply fence on lane telegram:<chat>;
#    keeping the lane guarded"
#   "... did not stop within 5s after reply abort; keeping lane telegram:<chat> guarded"
# A guarded lane silently drops every reply on that chat. The agent looks completely dead
# and stays dead until the gateway is restarted. Rotating the session (/new) does NOT clear
# it, because the guard lives in the channel layer, not the cli session.
#
# This watcher restarts the gateway when it sees the lane guarded and no successful outbound
# send afterwards. Cooldown prevents restart loops.
#
# Usage: lane-guard [--dry-run]
set -uo pipefail
. "$(cd "$(dirname "$0")/.." && pwd)/lib/config.sh"
DRY=0; [ "${1:-}" = "--dry-run" ] && DRY=1
STATE_DIR="$HOME/.local/state/neva"
mkdir -p "$STATE_DIR"
STATE="$STATE_DIR/lane-guard.state"
LOG="$STATE_DIR/lane-guard.log"
LANE="telegram:${OWNER_CHAT_ID}"
WINDOW_MIN=6
COOLDOWN_SEC=900

# PLATFORM FALSE-GREEN FIX (2026-08-01): this guard's entire detection mechanism is
# `journalctl -u openclaw-gateway`, i.e. systemd/journald. It is scheduled on macOS too
# (services/launchd/com.neva.lane-guard.plist.tmpl exists), where journalctl does not exist.
# Before this fix, that meant `$J` was always empty, the guard's condition could never be
# true, and it exited 0 every 2 minutes forever: a permanent false green that can structurally
# never catch the failure it exists to catch, indistinguishable in doctor from a guard that is
# actually working. Now it says so plainly, once, instead of silently reporting healthy.
if ! command -v journalctl >/dev/null 2>&1; then
  MSG="UNSUPPORTED: no journalctl on this platform ($(uname)); lane-guard needs systemd+journald and cannot detect anything here. If this is macOS, unload it: launchctl unload ~/Library/LaunchAgents/com.neva.lane-guard.plist"
  echo "$(date '+%F %T') $MSG" >> "$LOG"
  [ "$DRY" = "1" ] && echo "dry-run: $MSG"
  exit 3
fi

J=$(journalctl -u openclaw-gateway --since "-${WINDOW_MIN}m" --no-pager 2>/dev/null)

# most recent "keeping the lane guarded" for this lane
GUARD_TS=$(echo "$J" | grep "keeping the lane" | grep "$LANE" | tail -1 | grep -oE "^[A-Za-z]{3} [0-9]{2} [0-9:]{8}" || true)
# any successful outbound send for this chat inside the window
SENDS_AFTER=0
if [ -n "$GUARD_TS" ]; then
  SENDS_AFTER=$(echo "$J" | awk -v ts="$GUARD_TS" 'index($0,ts){seen=1} seen' | grep -c "outbound send ok" || true)
fi

if [ "$DRY" = "1" ]; then
  echo "dry-run: guarded=${GUARD_TS:-none} sends_after=$SENDS_AFTER -> $([ -n "$GUARD_TS" ] && [ "$SENDS_AFTER" -eq 0 ] && echo WOULD-RESTART || echo ok)"
  exit 0
fi

[ -n "$GUARD_TS" ] && [ "$SENDS_AFTER" -eq 0 ] || exit 0

NOW=$(date +%s)
LAST=$(cat "$STATE" 2>/dev/null || echo 0)
[ $(( NOW - LAST )) -lt "$COOLDOWN_SEC" ] && exit 0
echo "$NOW" > "$STATE"

echo "$(date '+%F %T') lane $LANE guarded at $GUARD_TS with no outbound after -> restarting gateway" >> "$LOG"
systemctl restart openclaw-gateway >> "$LOG" 2>&1
sleep 20

TOKEN=$(python3 -c 'import json, os; print(json.load(open(os.path.expanduser("~/.openclaw/openclaw.json")))["channels"]["telegram"]["botToken"])' 2>/dev/null)
if [ -n "$TOKEN" ]; then
  curl -s --max-time 15 "https://api.telegram.org/bot${TOKEN}/sendMessage" \
    --data-urlencode "chat_id=${OWNER_CHAT_ID}" \
    --data-urlencode "text=My channel was stuck and my replies were not reaching you. It is back now. If you sent something and got no reply, ask me again." >/dev/null 2>&1
fi
echo "$(date '+%F %T') gateway restarted + owner notified" >> "$LOG"
