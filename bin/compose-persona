#!/bin/bash
# compose-persona: build the files openclaw ACTUALLY reads from the layers we ship.
#
# The bug this fixes, found 2026-08-01 by capturing a real systemPromptReport: openclaw injects
# AGENTS.md and SOUL.md. This product shipped only AGENTS.base.md and SOUL.base.md, and nothing
# ever turned one into the other. Every behavioural rule in this product reached the agent
# exactly never, while the docs described them as governing its behaviour.
#
# The layering still works, it just needs a build step:
#   AGENTS.base.md   ours, replaced on upgrade
#   AGENTS.local.md  yours, never touched by us
#   AGENTS.md        GENERATED from those two. Do not hand-edit; edit the .local file.
#
# A pre-existing AGENTS.md that we did not generate is left alone: that is someone else's
# agent and overwriting it would be the workspace-clobber bug in a new costume.
set -u
WS="${1:-}"
[ -z "$WS" ] && { echo "compose-persona: no workspace path given" >&2
                  echo "fix: compose-persona /path/to/workspace" >&2; exit 64; }
[ -d "$WS" ] || { echo "compose-persona: no such workspace: $WS" >&2
                  echo "fix: run install.sh first, or pass the right path" >&2; exit 66; }

MARK="<!-- generated by neva compose-persona: edit the .local file, not this one -->"
built=0

for NAME in AGENTS SOUL; do
  BASE="$WS/$NAME.base.md"; LOCAL="$WS/$NAME.local.md"; OUT="$WS/$NAME.md"
  [ -f "$BASE" ] || continue

  if [ -f "$OUT" ] && ! head -3 "$OUT" | grep -qF "compose-persona"; then
    echo "compose-persona: $OUT exists and we did not generate it. Left untouched." >&2
    echo "fix: move it aside, or merge what you want into $NAME.local.md and delete it." >&2
    continue
  fi

  TMP="$(mktemp)"
  { echo "$MARK"; echo
    cat "$BASE"
    if [ -f "$LOCAL" ]; then
      echo; echo "# Your own rules"; echo
      echo "These come from $NAME.local.md and override anything above them on conflict."; echo
      cat "$LOCAL"
    fi
  } > "$TMP"
  mv "$TMP" "$OUT"; chmod 644 "$OUT"; built=$((built+1))
done

[ "$built" -eq 0 ] && { echo "compose-persona: nothing composed" >&2; exit 1; }
echo "composed $built persona file(s) into $WS"
